# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data backend: auto (default) | demo | supabase
DATA_BACKEND=

# Supabase (EU / Frankfurt empfohlen)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From supabase/seed.sql (Nordblick)
OPSFLOW_DEFAULT_ORG_ID=11111111-1111-1111-1111-111111111111

# ==========================================
# RETELL AI CONFIGURATION (Pilot / Live)
# ==========================================
RETELL_API_KEY=key_demo_or_live
RETELL_AGENT_ID=agent_xxxxxxxx
RETELL_LLM_ID=llm_xxxxxxxx
RETELL_VOICE_ID=11labs-Adrian
RETELL_WEBHOOK_SECRET=
# Force HMAC checks even in development
RETELL_WEBHOOK_ENFORCE=false

# Vercel / manual cron for 30-day recording cleanup
CRON_SECRET=

# Twilio (optional, if numbers are provisioned outside Retell)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional LLM (später für freien Simulator-Chat)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
